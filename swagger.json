{
    "swagger": "2.0",
    "info": {
        "title": "SchildCafé Servitør",
        "contact": {},
        "license": {
            "name": "Apache-2.0"
        }
    },
    "paths": {
        "/": {
            "get": {
                "produces": [
                    "text/plain"
                ],
                "summary": "Root endpoint",
                "responses": {
                    "200": {
                        "description": "Welcome to the SchildCafé!",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/healthcheck": {
            "get": {
                "description": "If all is fine, this will tell you.",
                "summary": "Perform a healthcheck",
                "responses": {
                    "200": {
                        "description": "Ok",
                        "schema": {
                            "$ref": "#/definitions/main.swaggResponse"
                        }
                    }
                }
            }
        },
        "/metrics": {
            "get": {
                "produces": [
                    "text/plain"
                ],
                "summary": "Get Prometheus metrics",
                "responses": {
                    "200": {
                        "description": "Prometheus metrics",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/order-list": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "summary": "Get list of all orders",
                "responses": {
                    "200": {
                        "description": "List of orders",
                        "schema": {
                            "$ref": "#/definitions/main.orderListResponse"
                        }
                    }
                }
            }
        },
        "/retrieve-order/{ID}": {
            "get": {
                "summary": "Retrieve an order",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Order ID",
                        "name": "ID",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Order",
                        "schema": {
                            "$ref": "#/definitions/main.order"
                        }
                    },
                    "404": {
                        "description": "Order not found",
                        "schema": {
                            "$ref": "#/definitions/main.swaggResponse"
                        }
                    },
                    "410": {
                        "description": "Order already delivered",
                        "schema": {
                            "$ref": "#/definitions/main.swaggResponse"
                        }
                    },
                    "503": {
                        "description": "Order not ready",
                        "schema": {
                            "$ref": "#/definitions/main.swaggResponse"
                        }
                    }
                }
            }
        },
        "/submit-order": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "summary": "Submit a new order",
                "parameters": [
                    {
                        "description": "Order to submit",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/main.orderSubmission"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Order ID",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Unable to accept order",
                        "schema": {
                            "$ref": "#/definitions/main.swaggResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "main.order": {
            "type": "object",
            "properties": {
                "orderBrewed": {
                    "description": "Number of coffees brewed so far",
                    "type": "integer"
                },
                "orderId": {
                    "type": "string"
                },
                "orderReady": {
                    "description": "Timestamp when the order was ready (0 before that)",
                    "type": "string"
                },
                "orderReceived": {
                    "description": "Timestamp when the order was received",
                    "type": "string"
                },
                "orderRetrieved": {
                    "description": "Timestamp when the order was retrieved (0 before that)",
                    "type": "string"
                },
                "orderSize": {
                    "description": "Total number of coffees in the order",
                    "type": "integer"
                }
            }
        },
        "main.orderEntry": {
            "type": "object",
            "properties": {
                "count": {
                    "type": "integer",
                    "example": 2
                },
                "product": {
                    "type": "string",
                    "example": "espresso"
                }
            }
        },
        "main.orderListResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/main.order"
                    }
                }
            }
        },
        "main.orderSubmission": {
            "type": "object",
            "properties": {
                "coffeeOrder": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/main.orderEntry"
                    }
                },
                "orderId": {
                    "description": "(optional) orderID",
                    "type": "string"
                }
            }
        },
        "main.swaggResponse": {
            "type": "object",
            "properties": {
                "body": {
                    "description": "in:body",
                    "type": "object",
                    "properties": {
                        "message": {
                            "description": "Detailed message",
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}